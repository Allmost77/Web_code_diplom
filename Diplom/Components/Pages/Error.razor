@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<MudStack Spacing="3">
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
        An error occurred while processing your request.
    </MudAlert>

    <MudText Typo="Typo.h4">Error</MudText>

    @if (ShowRequestId)
    {
        <MudText Typo="Typo.body2">
            <b>Request ID:</b> <code>@RequestId</code>
        </MudText>
    }

    <MudText Typo="Typo.h6">Development Mode</MudText>
    <MudText Typo="Typo.body1">
        Swapping to <b>Development</b> environment will display more detailed information about the error that occurred.
    </MudText>
    <MudText Typo="Typo.body1">
        The Development environment should not be enabled for deployed applications. It can display sensitive exception information to users.
    </MudText>
</MudStack>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
