@page "/home"
@attribute [Authorize]
@using Diplom.Data.Services
@inject LightingObjectService LightingObjectService

<PageTitle>Home</PageTitle>

<MudStack Spacing="4">
    <MudText Typo="Typo.h4">Домашняя страница</MudText>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            @errorMessage
        </MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2">Всего УНО</MudText>
                <MudText Typo="Typo.h4">@summary.TotalLightingObjects</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2">Проблемные УНО</MudText>
                <MudText Typo="Typo.h4">@summary.ProblemLightingObjects</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2">Задания в работе</MudText>
                <MudText Typo="Typo.h4">@summary.ActiveTasks</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2">Выполнено сегодня</MudText>
                <MudText Typo="Typo.h4">@summary.CompletedTodayTasks</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="2">
        <MudToolBar Class="px-4">
            <MudText Typo="Typo.h6">Последние УНО</MudText>
            <MudSpacer/>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/uno/create">
                Добавить УНО
            </MudButton>
        </MudToolBar>

        <MudTable Items="lightingObjects"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  Loading="isLoading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Инвентарный номер</MudTh>
                <MudTh>Адрес</MudTh>
                <MudTh>Статус</MudTh>
                <MudTh>Исполнитель</MudTh>
                <MudTh>Обновлено</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Инвентарный номер">
                    <MudText Typo="Typo.body2">@context.InventoryNumber</MudText>
                </MudTd>
                <MudTd DataLabel="Адрес">@context.Address</MudTd>
                <MudTd DataLabel="Статус">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetStatusColor(context.Status)">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Исполнитель">@context.Assignee</MudTd>
                <MudTd DataLabel="Обновлено">@(context.UpdatedAt?.ToString("dd.MM.yyyy") ?? "-")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                   Color="Color.Primary"
                                   Href="@($"/uno/{context.Id}")"/>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">УНО не найдены</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private DashboardSummaryDto summary = new();
    private List<LightingObjectDto> lightingObjects = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await LightingObjectService.GetDashboardSummaryAsync();
            lightingObjects = await LightingObjectService.GetLatestLightingObjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить данные из БД: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static Color GetStatusColor(string status) =>
        status switch
        {
            "Исправен" => Color.Success,
            "В работе" => Color.Info,
            "Требует проверки" => Color.Warning,
            "Авария" => Color.Error,
            _ => Color.Default
        };
}
