@page "/not-found"
@layout MainLayout

<MudStack Spacing="3">
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
        Страница не найдена
    </MudAlert>

    <MudText Typo="Typo.h4">Код ошибки 404</MudText>
    <MudText Typo="Typo.body1">Нам очень жаль, но запрошенная страница не найдена.</MudText>

    <MudButton Href="/home"
               Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Home">
        Вернуться на главную страницу
    </MudButton>
</MudStack>
