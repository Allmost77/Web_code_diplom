@page "/not-found"
@using MudBlazor
@inject NavigationManager NavManager
@code {
    private async Task GoBack(MouseEventArgs args)
    { 
       NavManager.NavigateTo("/home");
    }
}
@layout MainLayout

<h2> Код Ошибки 404</h2>
