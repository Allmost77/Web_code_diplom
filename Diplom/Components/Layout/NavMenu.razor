@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="nav-header px-3">
    <MudText Typo="Typo.h6" Class="navbar-brand">Админ панель Мосгорсвет</MudText>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <MudNavMenu>
        <MudNavLink Href="home"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Home">
            Домашняя страница
        </MudNavLink>

        <MudNavLink Href="map"
                    Icon="@Icons.Material.Filled.Map"
                    data-enhance-nav="false">
            Карта
        </MudNavLink>

        <MudNavLink Href="employees"
                    Icon="@Icons.Material.Filled.Person">
            Список сотрудников
        </MudNavLink>

        <MudNavLink Icon="@Icons.Material.Filled.Logout"
                    Disabled="isLoggingOut"
                    OnClick="LogoutAsync">
            Выход
        </MudNavLink>
    </MudNavMenu>
</div>

@code {
    private bool isLoggingOut;

    private async Task LogoutAsync()
    {
        if (isLoggingOut)
            return;

        isLoggingOut = true;
        await JSRuntime.InvokeVoidAsync("diplomAuth.logout");
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
