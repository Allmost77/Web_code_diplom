[Unit]
Description=Mosgorsvet Admin Panel
After=network.target

[Service]
WorkingDirectory=/var/www/mosgorsvet
ExecStart=/usr/bin/dotnet /var/www/mosgorsvet/Diplom.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=mosgorsvet
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000

[Install]
WantedBy=multi-user.target
