@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var relativeUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativeUrl)
            ? "/home"
            : "/" + relativeUrl;

        NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
