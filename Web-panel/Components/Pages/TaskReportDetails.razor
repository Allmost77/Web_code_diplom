@page "/tasks/{TaskId:int}/reports/{ReportId:int}"
@attribute [Authorize]
@using Diplom.Data.Services
@inject TaskReportService TaskReportService
@inject NavigationManager NavigationManager

<PageTitle>@(report is null ? "Отчёт" : $"Отчёт #{report.Id}")</PageTitle>

@if (isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-6">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </MudStack>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
        @errorMessage
    </MudAlert>
}
else if (report is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
        Отчёт не найден
    </MudAlert>
}
else
{
    <MudStack Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">Отчёт #@report.Id</MudText>
                <MudText Typo="Typo.body1">@report.TaskTitle</MudText>
                <MudText Typo="Typo.body2">
                    @report.LightingObjectInventoryNumber — @report.LightingObjectAddress
                </MudText>
            </MudStack>

            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">
                Назад к задаче
            </MudButton>
        </MudStack>

        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Информация об отчёте</MudText>

            <MudSimpleTable Dense="true">
                <tbody>
                <tr>
                    <td>Статус выполнения</td>
                    <td>@report.CompletionStatus</td>
                </tr>
                <tr>
                    <td>Дата формирования</td>
                    <td>@report.FormedAt.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
                <tr>
                    <td>Получен сервером</td>
                    <td>@report.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
                </tbody>
            </MudSimpleTable>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-2">Комментарий</MudText>
            <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">
                @(string.IsNullOrWhiteSpace(report.Comment) ? "-" : report.Comment)
            </MudText>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Фотографии</MudText>

            @if (report.Photos.Count == 0)
            {
                <MudText>Фотографии не прикреплены</MudText>
            }
            else
            {
                <MudGrid>
                    @foreach (var photo in report.Photos)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-2" Elevation="1">
                                <a href="@photo.FilePath" target="_blank" rel="noopener noreferrer">
                                    <img class="report-photo"
                                         src="@photo.FilePath"
                                         alt="@GetPhotoAlt(photo)"/>
                                </a>
                                <MudText Typo="Typo.caption">
                                    @(photo.OriginalFileName ?? $"Фото #{photo.Id}")
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter] public int TaskId { get; set; }
    [Parameter] public int ReportId { get; set; }

    private TaskReportDetailsDto? report;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            report = await TaskReportService.GetReportDetailsAsync(ReportId);

            if (report?.TaskId != TaskId)
                report = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить отчёт: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack() => NavigationManager.NavigateTo($"/tasks/{TaskId}");

    private static string GetPhotoAlt(TaskReportPhotoDto photo) =>
        photo.OriginalFileName ?? $"Фото #{photo.Id}";
}
