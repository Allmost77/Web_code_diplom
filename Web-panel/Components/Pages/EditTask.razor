@page "/tasks/{Id:int}/edit"
@attribute [Authorize]
@using Diplom.Data.Services
@using Microsoft.EntityFrameworkCore
@inject TaskService TaskService
@inject NavigationManager NavigationManager

<PageTitle>Изменить задачу</PageTitle>

@if (isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-6">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    </MudStack>
}
else if (model is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
        Задача не найдена
    </MudAlert>
}
else
{
    <MudStack Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h4">Изменить задачу</MudText>

            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="Cancel">
                Назад
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                @errorMessage
            </MudAlert>
        }

        <MudPaper Class="pa-4" Elevation="2">
            <MudForm @ref="form">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="model.Title"
                                      Label="Название"
                                      Required="true"
                                      RequiredError="Укажите название задачи"
                                      MaxLength="200"
                                      Variant="Variant.Outlined"/>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="int"
                                   @bind-Value="model.StatusId"
                                   Label="Статус"
                                   Required="true"
                                   RequiredError="Выберите статус"
                                   Variant="Variant.Outlined">
                            @foreach (var status in statuses)
                            {
                                <MudSelectItem T="int" Value="@status.Id">@status.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="int?"
                                   @bind-Value="model.AssignedToUserId"
                                   Label="Исполнитель"
                                   Variant="Variant.Outlined">
                            @foreach (var employee in employees)
                            {
                                <MudSelectItem T="int?" Value="@employee.Id">@employee.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="deadlineDate"
                                       Label="Дата выполнения"
                                       Variant="Variant.Outlined"/>
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudTimePicker @bind-Time="deadlineTime"
                                       Label="Время выполнения"
                                       Variant="Variant.Outlined"/>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="model.Description"
                                      Label="Описание"
                                      Lines="8"
                                      Variant="Variant.Outlined"/>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text"
                       Disabled="isSaving"
                       OnClick="Cancel">
                Отмена
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="isSaving || statuses.Count == 0"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Save">
                Сохранить
            </MudButton>
        </MudStack>
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? form;
    private TaskEditDto? model;
    private List<StatusOptionDto> statuses = [];
    private List<EmployeeOptionDto> employees = [];
    private DateTime? deadlineDate;
    private TimeSpan? deadlineTime;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            statuses = await TaskService.GetTaskStatusesAsync();
            employees = await TaskService.GetEmployeesAsync();
            model = await TaskService.GetTaskForEditAsync(Id);

            if (model?.Deadline is not null)
            {
                deadlineDate = model.Deadline.Value.Date;
                deadlineTime = model.Deadline.Value.TimeOfDay;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось загрузить задачу: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Save()
    {
        if (form is null || model is null)
            return;

        await form.ValidateAsync();

        if (!form.IsValid)
            return;

        model.Deadline = deadlineDate.HasValue && deadlineTime.HasValue
            ? deadlineDate.Value.Date.Add(deadlineTime.Value)
            : null;

        isSaving = true;
        errorMessage = null;

        try
        {
            var updated = await TaskService.UpdateTaskAsync(model);

            if (!updated)
            {
                errorMessage = "Задача не найдена. Возможно, она уже удалена.";
                return;
            }

            NavigationManager.NavigateTo($"/tasks/{model.Id}");
        }
        catch (DbUpdateException ex)
        {
            errorMessage = $"Не удалось сохранить задачу. {ex.GetBaseException().Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось сохранить задачу: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => NavigationManager.NavigateTo($"/tasks/{Id}");
}
